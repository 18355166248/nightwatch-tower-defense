{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "assets/scripts",
    "outDir": ".test-dist"
  },
  "include": [
    "assets/scripts/core/**/*.ts",
    "assets/scripts/audio/**/*.ts",
    "assets/scripts/input/TowerInspection.ts",
