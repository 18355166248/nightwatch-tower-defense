    "assets/scripts/presentation/FirstLevelPanelPainter.ts",
    "assets/scripts/presentation/FirstLevelResultPainter.ts",
    "assets/scripts/presentation/FirstLevelUiSkinView.ts",
    "assets/scripts/presentation/VisibleHudLabel.ts",
