    "assets/scripts/presentation/CombatForegroundView.ts",
    "assets/scripts/presentation/FirstLevelHudChromeView.ts",
    "assets/scripts/presentation/HudResourceIconView.ts",
    "assets/scripts/presentation/BattlefieldSurfaceView.ts",
    "assets/scripts/presentation/DynamicRoadView.ts",
    "assets/scripts/presentation/EnemySlowIndicatorView.ts",
    "assets/scripts/presentation/LayeredTowerRig.ts",
    "assets/scripts/presentation/CoreObjectiveView.ts",
