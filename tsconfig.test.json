{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "assets/scripts",
    "outDir": ".test-dist"
  },
  "include": [
    "assets/scripts/core/**/*.ts",
    "assets/scripts/config/**/*.ts",
    "assets/scripts/systems/**/*.ts",
    "assets/scripts/presentation/**/*.ts"
  ]
}
